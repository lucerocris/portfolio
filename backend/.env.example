# MongoDB connection string.
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority
# Local:  mongodb://127.0.0.1/portfolio
# Docker: mongodb://mongo/portfolio  (service name from docker-compose.yml)
DATABASE_URL=mongodb://127.0.0.1/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# DigitalOcean Spaces — where media uploads are stored.
# Leave all four blank to fall back to local disk (fine for dev; local disk does
# NOT survive a redeploy, so production must set these).
# Keys come from the DO console: API -> Spaces Keys.
# Region is the bucket's region slug, e.g. sgp1, nyc3, fra1.
DO_SPACES_BUCKET=
DO_SPACES_REGION=
DO_SPACES_KEY=
DO_SPACES_SECRET=

# Optional. Endpoint is derived from the region if omitted.
DO_SPACES_ENDPOINT=
# Optional. Set to serve images straight off the CDN instead of through Payload.
DO_SPACES_CDN_URL=
