---
/**
 * Site navigation. Before this existed, /projects was the only internal link
 * anywhere and /about was orphaned — reachable by URL and indexable, but
 * unlinked from the site itself.
 */
import CtaButton from "./CtaButton.astro";
import {primaryCta} from "../lib/site";

const path = Astro.url.pathname;

const links = [
    {href: "/projects", label: "Projects"},
    {href: "/about", label: "About"},
];

const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="mx-auto w-full max-w-7xl px-6 pt-8 md:px-12 md:pt-10">
    <nav class="flex items-center justify-between gap-4" aria-label="Main">
        <a href="/"
           class="text-sm font-medium whitespace-nowrap text-white transition-opacity hover:opacity-70"
           aria-current={path === "/" ? "page" : undefined}>
            Cris Lucero
        </a>

        <ul class="flex items-center gap-4 sm:gap-6">
            {links.map(({href, label}) => (
                    <li>
                        <a
                                href={href}
                                aria-current={isActive(href) ? "page" : undefined}
                                class:list={[
                                    "text-sm transition-colors",
                                    isActive(href) ? "text-white" : "text-zinc-400 hover:text-white",
                                ]}
                        >
                            {label}
                        </a>
                    </li>
            ))}
            {primaryCta() && (
                    <li>
                        <CtaButton size="sm" compactLabel="Book a call"/>
                    </li>
            )}
        </ul>
    </nav>
</header>
