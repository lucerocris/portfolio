---
/**
 * Navigation for the case-study pages. The home page is a one-pager with its
 * own header; these links point back into its sections.
 */

const path = Astro.url.pathname;

const links = [
    {href: "/#index", label: "Work"},
    {href: "/#about", label: "About"},
    {href: "/#contact", label: "Contact"},
];

// Work is active on case-study pages; About and Contact live on the home page.
const isActive = (href: string) => href === "/#index" && path.startsWith("/projects/");
---

<header class="mx-auto w-full max-w-7xl px-6 pt-8 md:px-12 md:pt-10">
    <nav class="flex items-center justify-between gap-2" aria-label="Main">
        <a href="/"
           class="text-sm font-medium whitespace-nowrap text-white transition-opacity hover:opacity-70"
           aria-current={path === "/" ? "page" : undefined}>
            Cris Lucero
        </a>

        <ul class="flex items-center gap-3 sm:gap-6">
            {links.map(({href, label}) => (
                    <li>
                        <a
                                href={href}
                                aria-current={isActive(href) ? "page" : undefined}
                                class:list={[
                                    "text-sm transition-colors",
                                    isActive(href) ? "text-white" : "text-zinc-400 hover:text-white",
                                ]}
                        >
                            {label}
                        </a>
                    </li>
            ))}
        </ul>
    </nav>
</header>
