---
/** The outbound links on a case study; App Store links get a badge-style button. */
import {Apple, ArrowUpRight, Github} from "@lucide/astro";
import type {ProjectLink} from "../lib/cms";

interface Props {
    links: ProjectLink[];
}

const {links} = Astro.props;
---

{links.length > 0 && (
    <ul class="flex flex-wrap items-center gap-x-8 gap-y-4">
        {links.map((link) => (
                <li>
                    {link.kind === "appstore" ? (
                            <a href={link.url} target="_blank" rel="noopener noreferrer"
                               aria-label={link.label}
                               class="inline-flex items-center gap-3 rounded-xl border border-zinc-600 bg-black px-4 py-2 text-white transition-colors hover:border-zinc-300">
                                <Apple size={26} aria-hidden="true"/>
                                <span class="flex flex-col leading-tight">
                                    <span class="text-[0.65rem] text-zinc-300">Download on the</span>
                                    <span class="text-lg font-semibold">App Store</span>
                                </span>
                            </a>
                    ) : (
                            <a href={link.url} target="_blank" rel="noopener noreferrer" class="group w-fit">
                                <span class="flex items-center gap-2">
                                    {link.kind === "github" && <Github class="h-5 w-5 text-white" aria-hidden="true"/>}
                                    <span class="border-b border-transparent font-medium text-white transition-colors duration-300 group-hover:border-white">
                                        {link.label}
                                    </span>
                                    <ArrowUpRight
                                            class="h-5 w-5 text-white transition-transform duration-300 group-hover:-translate-y-1 group-hover:translate-x-1"
                                            aria-hidden="true"/>
                                </span>
                            </a>
                    )}
                </li>
        ))}
    </ul>
)}
