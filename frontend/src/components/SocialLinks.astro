---
/** Icon links to Cris's social profiles, from src/lib/site.ts. */
import {Facebook, Github, Instagram, Linkedin} from "@lucide/astro";
import {site, type SocialIcon} from "../lib/site";

interface Props {
    class?: string;
    size?: number;
}

const {class: className, size = 24} = Astro.props;

const icons: Record<SocialIcon, typeof Github> = {
    github: Github,
    linkedin: Linkedin,
    instagram: Instagram,
    facebook: Facebook,
};
---

{site.socials.length > 0 && (
    <ul class:list={["flex items-center gap-4", className]}>
        {site.socials.map(({href, label, icon}) => {
            const Icon = icons[icon];
            return (
                <li>
                    <a href={href} target="_blank" rel="noopener noreferrer" aria-label={label} title={label}
                       class="block text-zinc-400 transition-colors hover:text-white">
                        <Icon size={size} aria-hidden="true"/>
                    </a>
                </li>
            );
        })}
    </ul>
)}
