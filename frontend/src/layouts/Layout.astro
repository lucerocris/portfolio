---
/**
 * Page shell for the case-study pages. The home page is a one-pager with its
 * own shell (see pages/index.astro); both share components/Head.astro.
 */
import "../styles/global.css";
import Head from "../components/Head.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
// Preload the Latin subset of the self-hosted font so text renders in Onest
// on first paint instead of swapping.
import onestLatin from "@fontsource-variable/onest/files/onest-latin-wght-normal.woff2?url";

interface Props {
    title: string;
    description: string;
    ogImage?: string;
    ogImageWidth?: number | null;
    ogImageHeight?: number | null;
    ogImageAlt?: string;
    ogType?: "website" | "article";
    imageUrls?: (string | undefined)[];
    /** Pages that lay out their own full-height hero opt out of min-h-screen. */
    bodyClass?: string;
}

const {bodyClass = "bg-[#151419] min-h-screen w-full text-white", ...head} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <Head {...head} fontPreloads={[onestLatin]}/>
</head>
<body class={bodyClass}>
<Nav/>
<main>
    <slot/>
</main>
<Footer/>
</body>
</html>
