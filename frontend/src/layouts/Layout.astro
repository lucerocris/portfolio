---
/**
 * Shared page shell. Every page renders through this so meta, Open Graph,
 * canonical URLs and the favicon stay consistent — previously each page
 * duplicated the whole <head> and they drifted apart.
 */
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import {site} from "../lib/site";
// Preload the Latin subset of the self-hosted font so text renders in Onest
// on first paint instead of swapping.
import onestLatin from "@fontsource-variable/onest/files/onest-latin-wght-normal.woff2?url";

interface Props {
    title: string;
    description: string;
    /** Absolute URL or site-root-relative path. Falls back to the profile photo. */
    ogImage?: string;
    ogType?: "website" | "article";
    /** Pages that lay out their own full-height hero opt out of min-h-screen. */
    bodyClass?: string;
}

const {
    title,
    description,
    ogImage = "/profile.webp",
    ogType = "website",
    bodyClass = "bg-[#151419] min-h-screen w-full text-white",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = ogImage.startsWith("http") ? ogImage : new URL(ogImage, Astro.site).href;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="canonical" href={canonical}>

    <title>{title}</title>
    <meta name="description" content={description}>

    <meta property="og:type" content={ogType}>
    <meta property="og:site_name" content={site.name}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonical}>
    <meta property="og:image" content={ogImageUrl}>

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={ogImageUrl}>

    <link rel="preload" href={onestLatin} as="font" type="font/woff2" crossorigin>
</head>
<body class={bodyClass}>
<Nav/>
<main>
    <slot/>
</main>
<Footer/>
</body>
</html>
