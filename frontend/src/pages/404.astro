---
import Layout from "../layouts/Layout.astro";
import {ArrowRight} from "@lucide/astro";
---

<Layout
        title="Page not found | Cris Lucero"
        description="That page does not exist."
>
    <div class="mx-auto h-full max-w-7xl px-6 py-20 md:px-12 md:py-40">
        <div class="flex flex-col gap-6">
            <p class="text-sm tracking-wide text-zinc-400 uppercase">404</p>

            <h1 class="text-3xl font-semibold md:text-5xl">Page not found</h1>

            <p class="max-w-xl text-zinc-400">
                That page doesn't exist — it may have moved, or the link that brought you here may be out of date.
            </p>

            <div class="flex flex-col gap-3 sm:flex-row sm:gap-8">
                <a href="/projects" class="group w-fit">
                    <div class="flex items-center gap-2">
                        <p class="border-b border-transparent font-medium text-white transition-colors duration-300 group-hover:border-white">
                            See the work
                        </p>
                        <ArrowRight
                                class="h-5 w-5 text-white transition-transform duration-300 group-hover:translate-x-1"/>
                    </div>
                </a>

                <a href="/" class="group w-fit">
                    <div class="flex items-center gap-2">
                        <p class="border-b border-transparent text-zinc-400 transition-colors duration-300 group-hover:border-zinc-400">
                            Back home
                        </p>
                    </div>
                </a>
            </div>
        </div>
    </div>
</Layout>
