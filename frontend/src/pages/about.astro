---
import Layout from "../layouts/Layout.astro";
import WorkWithMe from "../components/WorkWithMe.astro";
import {ArrowRight, ChevronDown, Download, MapPin} from "@lucide/astro";
import {site} from "../lib/site";

// No per-request data, so this page is built once and served from the CDN.
export const prerender = true;

const services = [
    {
        title: "Build it end to end",
        body:
            "Database, API, interface and admin, delivered by one person. You get a working product rather " +
            "than pieces to assemble.",
    },
    {
        title: "Web, mobile and commerce",
        body:
            "Marketing sites, web applications, mobile apps and online stores — whatever shape the product " +
            "needs to take to reach your customers.",
    },
    {
        title: "Built to run day to day",
        body:
            "Admin tools, dashboards and reporting, so your team can manage the product themselves without " +
            "a developer for every change.",
    },
];

const stack = [
    {
        label: "Languages",
        items: ["TypeScript", "JavaScript", "PHP", "Dart"],
    },
    {
        label: "Frontend",
        items: ["React", "Next.js", "Astro", "Tailwind CSS", "Flutter"],
    },
    {
        label: "Backend & data",
        items: ["Node.js", "Payload CMS", "CodeIgniter", "Supabase", "PostgreSQL", "MongoDB", "MySQL", "Redis"],
    },
    {
        label: "Platform",
        items: ["DigitalOcean", "Vercel", "Shopify", "Pusher", "PostHog"],
    },
];

// The headline tools, shown up front; the full list sits behind a toggle.
const highlights = ["TypeScript", "Next.js", "React", "Flutter", "Supabase", "PostgreSQL", "PHP", "Shopify"];
---

<Layout
        title="About | Cris Lucero"
        description="Cris Lucero is a web and app developer based in Cebu, Philippines, building web, mobile and commerce products end to end — from database schema to shipped interface."
>


<div class="mx-auto max-w-7xl px-6 py-20 md:px-12 md:py-40">

    <div class="flex flex-col gap-16 md:gap-24">

        {/* Intro */}
        <section class="flex flex-col gap-6">
            <div class="h-18 w-18 rounded-full">
                <img src="/avatar.webp" alt="Portrait of Cris Lucero" width="72" height="72" class="h-full w-full rounded-full object-cover">
            </div>

            <div class="flex flex-col gap-3">
                <h1 class="text-3xl font-bold md:text-5xl">About</h1>
                <p class="flex items-center gap-2 text-sm text-zinc-400">
                    <MapPin size={16} aria-hidden="true"/>
                    Based in {site.location}
                </p>
            </div>

            <div class="flex max-w-2xl flex-col gap-4 text-zinc-400">
                <p>
                    I'm Cris Lucero. I build the software businesses run on — the product customers use and the
                    back office that keeps it working — and I take it from empty repository to live.
                </p>
                <p>
                    That means one person accountable for the whole thing, rather than coordinating separate
                    specialists and owning the gaps between them.
                </p>
                <p>
                    An event platform that handled 600 registrations and ran check-in on the night. A tournament
                    system carried to production and maintained since. A cafe platform where owners manage their
                    own listing, menu and photos, and see how customers are finding them.
                </p>
                <p>
                    I'm also studying BS Computer Science at the University of San Carlos, where I was a Dean's
                    Lister in my first year.
                </p>
            </div>

            <div class="flex flex-wrap items-center gap-x-8 gap-y-4">
                <a href="/projects" class="group w-fit">
                    <div class="flex items-center gap-2">
                        <p class="border-b border-transparent font-medium text-white transition-colors duration-300 group-hover:border-white">
                            See the work
                        </p>
                        <ArrowRight
                                class="h-5 w-5 text-white transition-transform duration-300 group-hover:translate-x-1"/>
                    </div>
                </a>
                {site.cvPath && (
                        <a href={site.cvPath} download class="group w-fit">
                            <div class="flex items-center gap-2">
                                <Download class="h-5 w-5 text-zinc-300" aria-hidden="true"/>
                                <p class="border-b border-transparent text-zinc-300 transition-colors duration-300 group-hover:border-zinc-300">
                                    Download CV (PDF)
                                </p>
                            </div>
                        </a>
                )}
            </div>
        </section>

        {/* Value */}
        <section class="flex flex-col gap-6">
            <h2 class="border-b border-zinc-500 pb-3 text-sm tracking-wide text-zinc-400 uppercase">
                How I help
            </h2>

            <div class="grid grid-cols-1 gap-10 md:grid-cols-3 md:gap-8">
                {services.map((service) => (
                        <div class="flex max-w-md flex-col gap-3">
                            <h3 class="text-lg font-medium text-white">{service.title}</h3>
                            <p class="text-zinc-400">{service.body}</p>
                        </div>
                ))}
            </div>
        </section>

        {/* Stack */}
        <section class="flex flex-col gap-6">
            <h2 class="border-b border-zinc-500 pb-3 text-sm tracking-wide text-zinc-400 uppercase">
                What I work with
            </h2>

            <ul class="flex flex-wrap gap-2" aria-label="Main tools">
                {highlights.map((item) => (
                        <li class="rounded-full border border-zinc-700 px-3 py-1 text-sm text-zinc-300">{item}</li>
                ))}
            </ul>

            <details class="group">
                <summary class="flex w-fit cursor-pointer list-none items-center gap-2 text-sm text-zinc-300 transition-colors hover:text-white [&::-webkit-details-marker]:hidden">
                    <span class="border-b border-transparent group-hover:border-zinc-300">Full stack</span>
                    <ChevronDown size={16} class="transition-transform group-open:rotate-180" aria-hidden="true"/>
                </summary>
                <div class="pt-6">
                    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
                        {stack.map((group) => (
                                <div class="flex flex-col gap-3">
                                    <h3 class="text-sm text-zinc-400">{group.label}</h3>
                                    <ul class="flex flex-wrap gap-2">
                                        {group.items.map((item) => (
                                                <li class="rounded-full border border-zinc-700 px-3 py-1 text-sm text-zinc-300">
                                                    {item}
                                                </li>
                                        ))}
                                    </ul>
                                </div>
                        ))}
                    </div>
                </div>
            </details>
        </section>

        <WorkWithMe/>
    </div>
</div>


</Layout>
