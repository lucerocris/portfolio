---
import Layout from "../layouts/Layout.astro";
import CtaButton from "../components/CtaButton.astro";
import SocialLinks from "../components/SocialLinks.astro";
import TestimonialStrip from "../components/TestimonialStrip.astro";
import {ArrowRight, LayoutDashboard, TrendingUp, Zap} from "@lucide/astro";
import {site, startingPriceText} from "../lib/site";

// Static page: the hero has no CMS data. Testimonials load through a server
// island so quotes added in the CMS appear without a rebuild.
export const prerender = true;

const priceText = startingPriceText();

// What a business owner gets, readable in one glance under the hero.
const value = [
    {icon: TrendingUp, title: "Win more customers", body: "Be easy to find and easy to buy from, on any device."},
    {icon: LayoutDashboard, title: "Run things smoothly", body: "Custom software that fits how your business already works."},
    {icon: Zap, title: "Automate the busywork", body: "Let repetitive tasks run on their own, so your team can focus on what matters."},
];
---
<Layout
        title={`${site.name} — Web & App Developer in Cebu`}
        description="Cris Lucero is a web and app developer based in Cebu, Philippines, building websites, apps and business systems that help companies win customers and run smoothly."
>

<div class="mx-auto max-w-7xl px-6 py-20 md:px-12 md:py-32">
    <div class="flex flex-col gap-16 md:gap-24">
        <section class="flex flex-col gap-8" aria-labelledby="hero-heading">
            <div class="flex flex-col gap-5">
                <div class="h-18 w-18 rounded-full">
                    <img src="/avatar.webp" alt="Portrait of Cris Lucero" width="72" height="72" fetchpriority="high"
                         class="h-full w-full rounded-full object-cover">
                </div>

                <p class="text-sm font-medium text-zinc-400">Web &amp; app developer · {site.location}</p>

                <h1 id="hero-heading" class="max-w-4xl text-3xl font-bold text-balance text-white md:text-5xl md:leading-tight">
                    Websites and systems that help your business grow and run smoothly.
                </h1>

                <p class="max-w-2xl text-lg text-zinc-300 md:text-xl">
                    Have a problem in your business that technology could fix? I build the software and automation
                    that solves it, so you spend less time on busywork and more time growing.
                </p>
            </div>

            <div class="flex flex-col gap-3">
                <div class="flex flex-wrap items-center gap-x-8 gap-y-4">
                    <CtaButton/>
                    <a href="/projects" class="group w-fit">
                        <span class="flex items-center gap-2">
                            <span class="border-b border-transparent font-medium text-white transition-colors duration-300 group-hover:border-white">
                                See the work
                            </span>
                            <ArrowRight class="h-5 w-5 text-white transition-transform duration-300 group-hover:translate-x-1"
                                        aria-hidden="true"/>
                        </span>
                    </a>
                </div>
                {priceText && <p class="text-sm text-zinc-400">{priceText}</p>}
            </div>

            <ul class="grid max-w-5xl grid-cols-1 gap-6 border-t border-zinc-800 pt-8 sm:grid-cols-3 sm:gap-8"
                aria-label="What you get">
                {value.map(({icon: Icon, title, body}) => (
                        <li class="flex flex-col gap-2">
                            <Icon class="h-5 w-5 text-white" aria-hidden="true"/>
                            <p class="font-medium text-white">{title}</p>
                            <p class="text-sm text-zinc-400">{body}</p>
                        </li>
                ))}
            </ul>

            <p class="text-sm text-zinc-400">
                Recent work: <a href="/projects/nook" class="text-zinc-300 underline-offset-4 hover:text-white hover:underline">Nook</a>, a café app on the App Store
                · <a href="/projects/picklerank" class="text-zinc-300 underline-offset-4 hover:text-white hover:underline">PickleRank PH</a>, tournaments and online payments
                · <a href="/projects/nap-atlas" class="text-zinc-300 underline-offset-4 hover:text-white hover:underline">Nap Atlas</a>, an online store for an Australian brand
            </p>

            <SocialLinks/>
        </section>

        <TestimonialStrip server:defer/>
    </div>
</div>
</Layout>
