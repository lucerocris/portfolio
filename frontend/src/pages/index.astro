---
/**
 * The home page: a one-screen index of selected work, with About, Contact and
 * a case panel per project swapping in place (hash routes: #about, #contact,
 * #work/<slug>). Design: Figma "Portfolio — One-pager directions", page
 * "B — Index (final)".
 *
 * Without JS it is one long page with the same sections stacked, and every
 * link still works as an in-page anchor.
 */
import Head from "../components/Head.astro";
import Mark from "../components/Mark.astro";
import "@fontsource-variable/archivo";
import "@fontsource-variable/jetbrains-mono";
import "../styles/index.css";
import archivoLatin from "@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url";
import monoLatin from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url";
import {contactMethods, site} from "../lib/site";
import {experience, work} from "../lib/work";

export const prerender = true;

const pad = (n: number) => `(${String(n).padStart(2, "0")})`;
const year = new Date().getFullYear();

const linkedin = site.socials.find((s) => s.icon === "linkedin");
const github = site.socials.find((s) => s.icon === "github");
const instagram = site.socials.find((s) => s.icon === "instagram");
const email = contactMethods().find((m) => m.kind === "email");

// The contact list, in the order people should reach for them.
const channels = [
    {label: "Messenger", value: site.messengerUrl.replace(/^https?:\/\//, ""), href: site.messengerUrl},
    email && {label: "Email", value: email.label, href: email.href},
    github && {label: "GitHub", value: github.href.replace(/^https?:\/\//, ""), href: github.href},
    linkedin && {label: "LinkedIn", value: "in/cris-lawrence-lucero", href: linkedin.href},
    instagram && {label: "Instagram", value: "@" + instagram.href.replace(/\/$/, "").split("/").pop(), href: instagram.href},
    {label: "Résumé", value: site.cvPath.replace(/^\//, ""), href: site.cvPath, download: true},
].filter(Boolean) as { label: string; value: string; href: string; download?: boolean }[];

const footLinks = [
    email ? {label: "Email", href: email.href} : {label: "Messenger", href: site.messengerUrl},
    github && {label: "GitHub", href: github.href},
    linkedin && {label: "LinkedIn", href: linkedin.href},
    {label: "Résumé", href: site.cvPath},
].filter(Boolean) as { label: string; href: string }[];

const external = (href: string) => /^https?:/.test(href);

const sections = [
    {id: "index", label: "Index"},
    {id: "experience", label: "Experience"},
    {id: "about", label: "About"},
    {id: "contact", label: "Contact"},
];
---

<!DOCTYPE html>
<html lang="en">
<head>
    <Head
            title={`${site.name} — Web & App Developer in Cebu`}
            description={`Cris Lucero is a web and app developer in Cebu, Philippines. Selected work: ${work.map((p) => p.title).join(", ")}.`}
            fontPreloads={[archivoLatin, monoLatin]}
    />
    <meta name="theme-color" content="#F1F0EB">
    <script is:inline>document.documentElement.classList.add("js");</script>
</head>
<body class="op" data-view="index">

<div class="op-grid" aria-hidden="true">
    {Array.from({length: 12}, (_, i) => <span style={`--i:${i}`}></span>)}
</div>

<header class="op-top">
    <a class="op-mark" href="#index" aria-label={site.name}><Mark size={20} /><span class="op-name">{site.name}</span></a>
    <p class="op-role mono muted">Developer — Cebu, PH</p>
    <nav class="op-nav mono" aria-label="Sections">
        {sections.map((s, i) => (
                <a href={`#${s.id}`} data-nav={s.id} aria-current={i === 0 ? "page" : undefined}>{s.label}</a>
        ))}
    </nav>
    <button class="menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="menu">
        <span class="menu-bar"></span>
        <span class="menu-bar"></span>
    </button>
</header>

<!-- Phone menu (JS only; without JS the inline links above stay visible). -->
<div class="menu" id="menu" inert>
    <nav class="menu-nav" aria-label="Sections menu">
        {sections.map((s, i) => (
                <a href={`#${s.id}`} data-nav={s.id} class="menu-link" style={`--i:${i}`}>
                    <span class="menu-mask"><span class="menu-label">{s.label}</span></span>
                    <span class="menu-num mono muted">{pad(i + 1)}</span>
                </a>
        ))}
    </nav>
    <div class="menu-foot mono">
        <p class="muted">Developer — Cebu, PH</p>
        {email && <a href={email.href}>{email.label}</a>}
    </div>
</div>

<main class="op-main">

    <!-- Index -->
    <section class="view view-index is-active" id="index" data-view="index" aria-labelledby="index-title">
        <h1 class="sr-only" id="index-title">Cris Lucero, web and app developer — selected work</h1>
        <div class="intro">
            <p class="intro-copy">Web and app developer in Cebu. I take products from first sketch to shipped:
                interface, backend, and the automations in between.</p>
            <p class="intro-status mono muted">Now — SWE intern,<br>open to select freelance work</p>
        </div>

        <div class="idx-wrap">
            <span class="idx-marker" aria-hidden="true"></span>
            <ol class="idx">
                {work.map((p, i) => (
                        <li style={`--i:${i}`}>
                            <a class="idx-link" href={`#work/${p.slug}`} data-i={i} aria-label={`${p.title}: ${p.tagline}`}>
                                <span class="idx-mask"><span class="idx-name">{p.name}</span></span>
                                <span class="idx-num mono" aria-hidden="true">{pad(i + 1)}</span>
                                <span class="idx-desc mono" aria-hidden="true">{p.tagline}</span>
                            </a>
                        </li>
                ))}
            </ol>
        </div>

        <div class="peek" aria-hidden="true">
            <p class="peek-hint mono muted"><span class="ink">{pad(work.length)} Selected projects</span><br>Hover to
                preview,<br>click to open.</p>
            <div class="peek-stack">
                <div class="peek-card">
                    <div class="peek-imgs">
                        {work.map((p, i) => (
                                <img src={p.image.src} alt="" data-i={i} width="1440" height="900" decoding="async"
                                     style={p.image.position ? `object-position:${p.image.position}` : undefined}>
                        ))}
                    </div>
                    <span class="tag mono">View case →</span>
                </div>
                <div class="peek-meta">
                    {work.map((p, i) => (
                            <div class="meta" data-i={i}>
                                <p class="mono ink">{pad(i + 1)} {p.title}</p>
                                <p class="meta-copy">{p.summary}</p>
                                <p class="mono muted">{p.stackShort}<br>{p.link?.label ?? p.status}</p>
                            </div>
                    ))}
                </div>
            </div>
        </div>
    </section>

    <!-- About -->
    <section class="view view-about" id="about" data-view="about" aria-labelledby="about-title">
        <p class="view-label mono">(About)</p>
        <div class="about-main">
            <h2 class="about-lead" id="about-title">I build products end to end: the interface, the backend, and the
                automations in between.</h2>
            <div class="about-cols">
                <div><p class="mono muted">Now</p><p>Software engineering intern, open to select freelance work.</p></div>
                <div><p class="mono muted">What I make</p><p>Web apps, mobile apps, Shopify stores and internal tools.</p></div>
                <div><p class="mono muted">Based</p><p>Cebu, Philippines. GMT+8, replies {site.replyTime}.</p></div>
            </div>
            <a class="btn mono" href={site.cvPath} download>Download résumé ↓</a>
        </div>
    </section>

    <!-- Experience -->
    <section class="view view-experience" id="experience" data-view="experience" aria-labelledby="experience-title">
        <div class="view-label">
            <p class="mono">(Experience)</p>
            <a class="mono muted label-link" href={site.cvPath} download>Full résumé ↓</a>
        </div>
        <div class="exp-main">
            <h2 class="exp-title" id="experience-title">Experience.</h2>
            <ol class="roles">
                {experience.map((r) => {
                    const Tag = r.href ? "a" : "div";
                    return (
                            <li>
                                <Tag class="role" href={r.href}>
                                    <span class="role-when mono muted">{r.when}</span>
                                    <span class="role-head">
                                        <span class="role-title">{r.title}</span>
                                        <span class="role-org mono muted">{r.org}</span>
                                    </span>
                                    <span class="role-note">{r.note}</span>
                                </Tag>
                            </li>
                    );
                })}
            </ol>
        </div>
    </section>

    <!-- Contact -->
    <section class="view view-contact" id="contact" data-view="contact" aria-labelledby="contact-title">
        <div class="view-label">
            <p class="mono">(Contact)</p>
            <p class="mono muted">Usually replies<br>{site.replyTime}.</p>
        </div>
        <div class="contact-main">
            <h2 class="contact-title" id="contact-title">Let's talk.</h2>
            <ul class="channels">
                {channels.map((c) => (
                        <li>
                            <a href={c.href} target={external(c.href) ? "_blank" : undefined}
                               rel={external(c.href) ? "noopener noreferrer" : undefined} download={c.download}>
                                <span class="channel-label mono muted">{c.label}</span>
                                <span class="channel-value">{c.value}</span>
                                <span class="channel-arrow mono" aria-hidden="true">↗</span>
                            </a>
                        </li>
                ))}
            </ul>
        </div>
    </section>

    <!-- Case panels -->
    {work.map((p, i) => {
        const prev = work[(i - 1 + work.length) % work.length];
        const next = work[(i + 1) % work.length];
        const pi = (i - 1 + work.length) % work.length;
        const ni = (i + 1) % work.length;
        return (
                <section class="view view-case" id={`work/${p.slug}`} data-view={`work/${p.slug}`}
                         aria-labelledby={`case-${p.slug}`}>
                    <p class="crumb mono"><a href="#index">← Index</a><span class="muted">&nbsp;&nbsp;/&nbsp;&nbsp;</span>{pad(i + 1)} {p.title}</p>
                    <h2 class="case-title" id={`case-${p.slug}`}><span>{p.title}</span></h2>
                    <div class="case-body">
                        <p class="case-sub">{p.subtitle}</p>
                        {p.body.map((t) => <p class="case-copy">{t}</p>)}
                        <dl class="facts">
                            <div><dt class="mono muted">Role</dt><dd>{p.role}</dd></div>
                            <div><dt class="mono muted">Stack</dt><dd>{p.stack}</dd></div>
                            <div><dt class="mono muted">Status</dt><dd>{p.status}</dd></div>
                        </dl>
                        {p.link && (
                                <a class="btn mono" href={p.link.href} target={external(p.link.href) ? "_blank" : undefined}
                                   rel={external(p.link.href) ? "noopener noreferrer" : undefined}>{p.link.text ?? `Visit ${p.link.label} ↗`}</a>
                        )}
                    </div>
                    {p.screens ? (
                            <figure class="case-fig case-phones">
                                <div class="phones">
                                    {p.screens.map((s) => (
                                            <img src={s.src} alt={s.alt} width="520" height="1130" loading="lazy" decoding="async">
                                    ))}
                                </div>
                                <figcaption class="mono muted">iOS app — Featured, Map, Café</figcaption>
                            </figure>
                    ) : (
                            <figure class="case-fig">
                                <img class="case-shot" src={p.image.src} alt={p.image.alt} width="1440" height="900" loading="lazy"
                                     decoding="async" style={p.image.position ? `object-position:${p.image.position}` : undefined}>
                                <figcaption class="mono muted">{p.image.caption}</figcaption>
                            </figure>
                    )}
                    <nav class="pager mono" aria-label="Projects">
                        <a href={`#work/${prev.slug}`} data-dir="prev">← {pad(pi + 1)} {prev.title}</a>
                        <span class="muted pager-hint">Esc to close</span>
                        <a href={`#work/${next.slug}`} data-dir="next">{pad(ni + 1)} {next.title} →</a>
                    </nav>
                </section>
        );
    })}
</main>

<!-- Phone preview: the first tap on a project opens this, the second opens the case. -->
<div class="sheet" aria-hidden="true">
    {work.map((p, i) => (
            <div class="sheet-item" data-i={i}>
                <img src={p.image.src} alt="" width="1440" height="900" loading="lazy" decoding="async"
                     style={p.image.position ? `object-position:${p.image.position}` : undefined}>
                <p class="mono ink">{pad(i + 1)} {p.title}</p>
                <p class="sheet-copy">{p.subtitle}</p>
                <a class="btn mono" href={`#work/${p.slug}`} tabindex="-1">Open case →</a>
            </div>
    ))}
</div>

<footer class="op-foot mono">
    <p class="foot-copy muted">© {year} {site.name}</p>
    <p class="foot-clock muted" data-clock>Cebu, GMT+8</p>
    <ul class="foot-links">
        {footLinks.map((l) => (
                <li><a href={l.href} target={external(l.href) ? "_blank" : undefined}
                       rel={external(l.href) ? "noopener noreferrer" : undefined}>{l.label}</a></li>
        ))}
    </ul>
</footer>

<script src="../scripts/index.ts"></script>
</body>
</html>
