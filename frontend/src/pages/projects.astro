---
import "../styles/global.css";
import {Breadcrumbs} from "astro-breadcrumbs";
import "astro-breadcrumbs/breadcrumbs.css";
import {ArrowRight} from "@lucide/astro";
import type {Project} from "@backend";

const CMS_URL = "http://localhost:3000";
let projects: Project[] = [];

try {
    const response = await fetch(`${CMS_URL}/api/projects?depth=1`);
    const data = await response.json();
    projects = data.docs || [];
} catch (error) {
    console.error("Failed to fetch projects from Payload:", error);
}
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Onest:wght@100..900&display=swap" rel="stylesheet">
    <title>Projects | Cris Lucero</title>
</head>
<body class="bg-[#151419] min-h-screen w-screen text-white font-['Onest']">

<div class="mx-auto h-full max-w-7xl px-6 py-20 md:px-12 md:py-40">

    <div class="mb-6">
        <Breadcrumbs
                indexText="Home"
                linkTextFormat="capitalized"
        />
    </div>

    <div class="flex flex-col gap-4 w-full">
        <h2 class="text-3xl font-semibold">See how I have helped businesses achieve their goals.</h2>
    </div>

    <div class="mt-10 md:mt-16 flex flex-col gap-16">

        {projects.length === 0 && (
                <p class="text-zinc-500">No projects found. Make sure the Payload server is running.</p>
        )}

        {projects.map((project, index) => (
                <div class="flex flex-col-reverse lg:flex-row gap-10">
                    <div class="flex-1 flex flex-col gap-4">

                        {/* Logo Handling */}
                        {project.logo && typeof project.logo !== 'string' && project.logo.url && (
                                <img
                                        src={`${CMS_URL}${project.logo.url}`}
                                        alt={`${project.title} logo`}
                                        class="w-20 object-contain"
                                />
                        )}

                        <div class="flex flex-col gap-3">
                            <h4 class="text-lg">{project.subtitle}</h4>
                            <p class="border-t border-t-zinc-500 py-3 text-zinc-300">
                                {project.shortDescription}
                            </p>
                        </div>

                        <a href={`/projects/${project.slug}`} class="group w-fit">
                            <div class="flex items-center gap-2">
                                <p class="text-white font-medium border-b border-transparent group-hover:border-white transition-colors duration-300">
                                    {project.cardLinkText || "View Project"}
                                </p>
                                <ArrowRight
                                        class="w-5 h-5 text-white transition-transform group-hover:translate-x-1 duration-300"/>
                            </div>
                        </a>

                    </div>

                    <div class="flex-1 flex rounded-lg">
                        {project.featuredImage && typeof project.featuredImage !== 'string' && project.featuredImage.url && (
                                <img
                                        src={`${CMS_URL}${project.featuredImage.url}`}
                                        alt={project.title}
                                        class="rounded-lg object-cover w-full h-auto"
                                />
                        )}
                    </div>
                </div>
            ))}
    </div>
</div>

<style is:global>
    .c-breadcrumbs__link {
        color: #71717a !important;
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .c-breadcrumbs__link:hover {
        color: #ffffff !important;
    }

    .c-breadcrumbs__item:last-child .c-breadcrumbs__link {
        color: #ffffff !important;
        pointer-events: none;
    }

    .c-breadcrumbs__separator {
        color: #52525b !important;
    }

    .c-breadcrumbs {
        font-family: 'Onest', sans-serif;
        font-size: 0.875rem;
    }
</style>
</body>
</html>
