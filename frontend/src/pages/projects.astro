---
import Layout from "../layouts/Layout.astro";
import {ArrowRight} from "@lucide/astro";
import type {Project} from "@backend";
import {CMS_URL, asMedia, sizedUrl} from "../lib/cms";
let projects: Project[] = [];

try {
    const response = await fetch(`${CMS_URL}/api/projects?depth=1`);
    const data = await response.json();
    projects = data.docs || [];
} catch (error) {
    console.error("Failed to fetch projects from Payload:", error);
}
---

<Layout
        title="Projects | Cris Lucero"
        description="Selected work — a cafe discovery platform, a pickleball tournament system, an event platform, a commerce storefront and a D2C travel brand."
>


<div class="mx-auto h-full max-w-7xl px-6 py-20 md:px-12 md:py-40">

    <div class="flex flex-col gap-4 w-full">
        <h1 class="text-3xl font-semibold">Products businesses run on.</h1>
        <p class="max-w-2xl text-zinc-400">
            Work across discovery, events, tournaments and commerce — each taken from database to interface,
            with the admin tools that keep it running day to day.
        </p>
    </div>

    <div class="mt-10 md:mt-16 flex flex-col gap-16">

        {projects.length === 0 && (
                <p class="text-zinc-400">No projects found. Make sure the Payload server is running.</p>
        )}

        {projects.map((project) => (
                <div class="flex flex-col-reverse lg:flex-row gap-10">
                    <div class="flex-1 flex flex-col gap-4">

                        {/* Logo Handling */}
                        {project.logo && typeof project.logo !== 'string' && project.logo.url && (
                                <img
                                        src={sizedUrl(asMedia(project.logo), 200)}
                                        loading="lazy"
                                        alt={`${project.title} logo`}
                                        class:list={["object-contain",
                                            project.logo.width && project.logo.height && project.logo.width / project.logo.height > 4
                                                ? "w-56" : "w-20"]}
                                />
                        )}

                        <div class="flex flex-col gap-3">
                            <h2 class="text-lg">{project.subtitle}</h2>
                            <p class="border-t border-t-zinc-500 py-3 text-zinc-300">
                                {project.shortDescription}
                            </p>
                        </div>

                        <a href={`/projects/${project.slug}`} class="group w-fit">
                            <div class="flex items-center gap-2">
                                <p class="text-white font-medium border-b border-transparent group-hover:border-white transition-colors duration-300">
                                    {project.cardLinkText || "View Project"}
                                </p>
                                <ArrowRight
                                        class="w-5 h-5 text-white transition-transform group-hover:translate-x-1 duration-300"/>
                            </div>
                        </a>

                    </div>

                    <div class="flex-1 flex rounded-lg">
                        {project.featuredImage && typeof project.featuredImage !== 'string' && project.featuredImage.url && (
                                <img
                                        src={sizedUrl(asMedia(project.featuredImage), 900)}
                                        loading="lazy"
                                        alt={project.title}
                                        class="rounded-lg object-cover w-full h-auto"
                                />
                        )}
                    </div>
                </div>
            ))}
    </div>
</div>


</Layout>
