---
import Layout from "../../layouts/Layout.astro";
import ConceptBadge from "../../components/ConceptBadge.astro";
import ProjectLinks from "../../components/ProjectLinks.astro";
import Testimonial from "../../components/Testimonial.astro";
import WorkWithMe from "../../components/WorkWithMe.astro";
import {Breadcrumbs} from "astro-breadcrumbs";
import "astro-breadcrumbs/breadcrumbs.css";
import {ArrowLeft} from "@lucide/astro";
import {lexicalToHtml} from "../../lib/lexical";
import {
    CMS_PAGE_CACHE_CONTROL,
    altText,
    asMedia,
    fetchProject,
    imageAttrs,
    projectLinks,
    projectTestimonial,
    sizedUrl,
} from "../../lib/cms";

const {slug = ""} = Astro.params;

const result = await fetchProject(slug);
const project = result.ok ? result.data : null;

// SSR (output: 'server'), so an unknown slug answers with a real 404 and a
// CMS outage with a 503. Only a successful render is cached at the edge.
if (!result.ok) {
    Astro.response.status = 503;
    Astro.response.headers.set("Retry-After", "60");
} else if (!project) {
    Astro.response.status = 404;
} else {
    Astro.response.headers.set("Cache-Control", CMS_PAGE_CACHE_CONTROL);
}

const body = lexicalToHtml(project?.content);
const services = (project?.services ?? []).map((s) => s.serviceName).filter(Boolean);
const techStack = (project?.techStack ?? []).map((t) => t.techName).filter(Boolean);
const links = project ? projectLinks(project) : [];
const testimonial = project ? projectTestimonial(project) : null;

const featuredImage = asMedia(project?.featuredImage);
const featured = imageAttrs(featuredImage);

// Full width of the 1280px container, minus side padding.
const FULL_SIZES = "(min-width: 1280px) 1184px, (min-width: 768px) calc(100vw - 96px), calc(100vw - 48px)";
// Half of it from the sm breakpoint, where the gallery becomes two columns.
const HALF_SIZES =
    "(min-width: 1280px) 580px, (min-width: 768px) calc(50vw - 60px), (min-width: 640px) calc(50vw - 36px), calc(100vw - 48px)";
// Portrait shots are capped at max-h-[36rem] (576px), so their rendered
// width follows from the aspect ratio (a 1206x2622 phone screen is ~265px)
// and the browser can pick the 400w file.
const PORTRAIT_MAX_HEIGHT = 576;

// Drop any gallery row whose upload is missing or not populated (depth=1 gives us objects).
// Portrait shots (phone screenshots) would otherwise render taller than the
// viewport in a grid column sized for landscape, so flag them for capping.
const gallery = (project?.gallery ?? []).flatMap((item) => {
    const image = asMedia(item.image);
    const attrs = imageAttrs(image);
    if (!image || !attrs) return [];
    const portrait = Boolean(image.width && image.height && image.height > image.width);
    const sizes = portrait && image.width && image.height
        ? `${Math.ceil((PORTRAIT_MAX_HEIGHT * image.width) / image.height)}px`
        : item.wide ? FULL_SIZES : HALF_SIZES;
    return [{image, attrs, sizes, caption: item.caption, wide: item.wide, portrait}];
});

// Share cards use the project's own hero, falling back to the default card.
const ogCard = featuredImage?.sizes?.card?.url ? featuredImage.sizes.card : null;
const ogImage = sizedUrl(featuredImage, 900);

const crumbs = [
    {text: "Home", href: "/"},
    {text: "Projects", href: "/projects"},
    ...(project ? [{text: project.title, href: `/projects/${project.slug}`, "aria-current": "page"}] : []),
];
---

<Layout
        title={project ? `${project.title} | Cris Lucero` : !result.ok ? "Project unavailable | Cris Lucero" : "Project not found | Cris Lucero"}
        description={project?.shortDescription ?? "This project could not be found."}
        ogImage={ogImage}
        ogImageWidth={ogCard?.width ?? featuredImage?.width}
        ogImageHeight={ogCard?.height ?? featuredImage?.height}
        ogImageAlt={project ? altText(featuredImage, project.title) : undefined}
        ogType="article"
        imageUrls={[featured?.src]}
>


<div class="mx-auto max-w-7xl px-6 py-20 md:px-12 md:py-40">

    <div class="mb-6">
        <Breadcrumbs crumbs={crumbs}/>
    </div>

    {!project && (
            <div class="flex flex-col gap-6">
                <h1 class="text-3xl font-semibold md:text-5xl">
                    {result.ok ? "Project not found" : "This project couldn't be loaded"}
                </h1>
                <p class="max-w-xl text-zinc-400">
                    {result.ok
                        ? "There's no project at this address. It may have been renamed or removed."
                        : "Something went wrong on our side. Please refresh the page, or try again in a few minutes."}
                </p>
                <a href="/projects" class="group w-fit">
                    <div class="flex items-center gap-2">
                        <ArrowLeft
                                class="h-5 w-5 text-white transition-transform duration-300 group-hover:-translate-x-1"/>
                        <p class="border-b border-transparent font-medium text-white transition-colors duration-300 group-hover:border-white">
                            All projects
                        </p>
                    </div>
                </a>
            </div>
    )}

    {project && (
            <article class="flex flex-col gap-12 md:gap-16">

                {/* Header */}
                <header class="flex flex-col gap-6">
                    <div class="flex flex-col gap-3">
                        {/* No logo here — most are wordmarks that just repeat the h1.
                            The listing page still shows them. */}
                        {project.isConcept && <ConceptBadge/>}
                        <h1 class="text-3xl font-semibold md:text-5xl">{project.title}</h1>
                        {project.subtitle && (
                                <p class="max-w-3xl text-lg text-zinc-300 md:text-xl">{project.subtitle}</p>
                        )}
                    </div>

                    <ProjectLinks links={links}/>
                </header>

                {/* Featured image: the LCP element, so it loads at high priority. */}
                {featured && (
                        <img
                                {...featured}
                                sizes={FULL_SIZES}
                                fetchpriority="high"
                                alt={altText(featuredImage, project.title)}
                                class="h-auto w-full rounded-lg object-cover"
                        />
                )}

                {/* Body + sidebar */}
                <div class="flex flex-col gap-12 lg:flex-row lg:gap-16">

                    <div class="flex-1">
                        {body ? (
                                <section class="flex flex-col gap-4">
                                    <h2 class="border-b border-zinc-500 pb-3 text-sm tracking-wide text-zinc-400 uppercase">
                                        About the project
                                    </h2>
                                    <div class="case-study-body" set:html={body}/>
                                </section>
                        ) : (
                                <p class="text-zinc-400">No write-up for this project yet.</p>
                        )}
                    </div>

                    {(services.length > 0 || techStack.length > 0) && (
                            <aside class="flex w-full flex-col gap-10 lg:w-72 lg:shrink-0">

                                {services.length > 0 && (
                                        <section class="flex flex-col gap-4">
                                            <h2 class="border-b border-zinc-500 pb-3 text-sm tracking-wide text-zinc-400 uppercase">
                                                Provided services
                                            </h2>
                                            <ul class="flex flex-col gap-2">
                                                {services.map((service) => (
                                                        <li class="text-zinc-300">{service}</li>
                                                ))}
                                            </ul>
                                        </section>
                                )}

                                {techStack.length > 0 && (
                                        <section class="flex flex-col gap-4">
                                            <h2 class="border-b border-zinc-500 pb-3 text-sm tracking-wide text-zinc-400 uppercase">
                                                Technology stack
                                            </h2>
                                            <ul class="flex flex-wrap gap-2">
                                                {techStack.map((tech) => (
                                                        <li class="rounded-full border border-zinc-700 px-3 py-1 text-sm text-zinc-300">
                                                            {tech}
                                                        </li>
                                                ))}
                                            </ul>
                                        </section>
                                )}
                            </aside>
                    )}
                </div>

                {/* Gallery */}
                {gallery.length > 0 && (
                        <section class="flex flex-col gap-6">
                            <h2 class="border-b border-zinc-500 pb-3 text-sm tracking-wide text-zinc-400 uppercase">
                                Gallery
                            </h2>
                            <div class="grid grid-cols-1 items-start gap-6 sm:grid-cols-2">
                                {gallery.map((item) => (
                                        <figure class:list={["flex flex-col gap-3", item.wide && "sm:col-span-2"]}>
                                            <img
                                                    {...item.attrs}
                                                    sizes={item.sizes}
                                                    alt={item.caption || altText(item.image, project.title)}
                                                    class:list={[
                                                        "rounded-lg",
                                                        item.portrait
                                                            ? "mx-auto max-h-[36rem] w-auto object-contain"
                                                            : "h-auto w-full object-cover",
                                                    ]}
                                                    loading="lazy"
                                                    decoding="async"
                                            />
                                            {item.caption && (
                                                    <figcaption class="text-sm text-zinc-400">{item.caption}</figcaption>
                                            )}
                                        </figure>
                                ))}
                            </div>
                        </section>
                )}

                {/* Testimonial */}
                {testimonial && (
                        <section class="flex flex-col gap-6">
                            <h2 class="border-b border-zinc-500 pb-3 text-sm tracking-wide text-zinc-400 uppercase">
                                What the client said
                            </h2>
                            <Testimonial testimonial={testimonial}/>
                        </section>
                )}

                <WorkWithMe heading="Want something like this for your business?"/>

                {/* Footer nav */}
                <nav class="border-t border-zinc-800 pt-8" aria-label="Case study">
                    <a href="/projects" class="group w-fit">
                        <div class="flex items-center gap-2">
                            <ArrowLeft
                                    class="h-5 w-5 text-white transition-transform duration-300 group-hover:-translate-x-1"/>
                            <p class="border-b border-transparent font-medium text-white transition-colors duration-300 group-hover:border-white">
                                All projects
                            </p>
                        </div>
                    </a>
                </nav>
            </article>
    )}
</div>

<style is:global>
    .c-breadcrumbs__link {
        color: #a1a1aa !important;
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .c-breadcrumbs__link:hover {
        color: #ffffff !important;
    }

    .c-breadcrumbs__item:last-child .c-breadcrumbs__link {
        color: #ffffff !important;
        pointer-events: none;
    }

    .c-breadcrumbs__separator {
        color: #52525b !important;
    }

    .c-breadcrumbs {
        font-family: inherit;
        font-size: 0.875rem;
    }

    /* Rich text coming from Payload's Lexical editor. */
    .case-study-body {
        color: #d4d4d8;
        max-width: 65ch;
    }

    .case-study-body > * + * {
        margin-top: 1.25rem;
    }

    .case-study-body h2,
    .case-study-body h3,
    .case-study-body h4 {
        color: #ffffff;
        font-weight: 600;
        margin-top: 2rem;
    }

    .case-study-body h2 {
        font-size: 1.5rem;
    }

    .case-study-body h3 {
        font-size: 1.25rem;
    }

    .case-study-body a {
        color: #ffffff;
        text-decoration: underline;
        text-underline-offset: 3px;
    }

    .case-study-body ul,
    .case-study-body ol {
        padding-left: 1.5rem;
    }

    .case-study-body ul {
        list-style: disc;
    }

    .case-study-body ol {
        list-style: decimal;
    }

    .case-study-body li + li {
        margin-top: 0.5rem;
    }

    .case-study-body blockquote {
        border-left: 2px solid #52525b;
        padding-left: 1rem;
        color: #a1a1aa;
        font-style: italic;
    }

    .case-study-body code {
        background: #27272a;
        border-radius: 0.25rem;
        padding: 0.125rem 0.375rem;
        font-size: 0.875em;
    }

    .case-study-body hr {
        border-color: #3f3f46;
    }
</style>
