{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "astro"
    },
    "backend": {
      "root": "backend",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)?",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/admin",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/admin/(.*)",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/_next/(.*)",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ]
}
